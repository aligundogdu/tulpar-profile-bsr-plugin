{
  "id": "dev.bsr.profile",
  "name": "Build Ship Repeat",
  "version": "1.1.1",
  "description": "Community profile fields for makers (monthly recurring revenue, active projects, shipped products) and referral invites: members ask, admins approve, the newcomer joins with a single-use link.",
  "author": {
    "name": "Build Ship Repeat"
  },
  "type": "hybrid",
  "permissions": [
    "profile:write",
    "messages:write",
    "members:read",
    "channels:read",
    "bot:dm",
    "invites:write"
  ],
  "capabilities": {
    "profileFields": [
      {
        "key": "mrr",
        "label": {
          "tr": "Aylık gelir",
          "en": "MRR"
        },
        "description": {
          "tr": "Aylık yinelenen gelirin. Boş bırakırsan kimse görmez.",
          "en": "Your monthly recurring revenue. Leave it empty and nobody sees it."
        },
        "type": "currency",
        "currency": "USD",
        "surfaces": [
          "profile-panel",
          "profile-hover"
        ],
        "icon": "trending-up",
        "placeholder": "0"
      },
      {
        "key": "active_projects",
        "label": {
          "tr": "Aktif proje",
          "en": "Active projects"
        },
        "description": {
          "tr": "Şu an üzerinde çalıştığın proje sayısı.",
          "en": "How many projects you are shipping right now."
        },
        "type": "number",
        "surfaces": [
          "profile-panel",
          "profile-hover"
        ],
        "icon": "rocket",
        "placeholder": "0"
      },
      {
        "key": "projects",
        "label": {
          "tr": "Projeler",
          "en": "Projects"
        },
        "type": "url-list",
        "maxItems": 5,
        "surfaces": [
          "profile-panel"
        ],
        "icon": "globe",
        "placeholder": "https://...",
        "linkParams": {
          "utm_source": "buildshiprepeat",
          "utm_medium": "profile"
        }
      }
    ],
    "slashCommands": [
      {
        "command": "davet",
        "description": "Referanslı davet: birini davet etmek için talep aç, yöneticiler onaylasın",
        "usage": "/davet [benim | talepler | onayla <no> | reddet <no> [sebep] | gecmis]"
      }
    ],
    "bot": {
      "displayName": {
        "tr": "Davet Botu",
        "en": "Invite Bot"
      },
      "acceptsMessages": false
    }
  },
  "settings": [
    {
      "key": "maxPendingPerMember",
      "type": "number",
      "label": "Bir üyenin en fazla bekleyen davet talebi",
      "description": "Varsayılan 3",
      "required": false
    }
  ],
  "backend": {
    "entrypoint": "src/Plugin.php"
  }
}
